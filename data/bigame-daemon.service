[Unit]
Description=Big Game Mode privileged helper
Documentation=https://github.com/biglinux/bigamemode
After=dbus.service polkit.service
Requires=dbus.service
# Polkit is how every method authorizes its caller. Without it the helper
# denies everything, so starting before it is pointless.
Wants=polkit.service

[Service]
Type=dbus
BusName=com.biglinux.BiGameMode
ExecStart=/usr/bin/bigame-daemon
Restart=on-failure
RestartSec=3

# The helper needs root to write sysfs and /etc/falcond, but nothing beyond
# that. Everything below removes access it never uses, so a bug in argument
# handling has as little reach as possible.
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
# It reads no other process's /proc, no /dev and no /tmp (the status file
# falcond publishes there is read by the UI, not by the helper).
ProtectProc=invisible
ProcSubset=pid
PrivateDevices=yes
PrivateTmp=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @obsolete
UMask=0022
# Every file the helper writes is root's own (cpufreq, DRM and V-Cache
# attributes, /etc/falcond, the profile directory, its state directory), so
# uid 0 needs no capability to write it: DAC_OVERRIDE, PTRACE, NET_*, SETUID
# and the rest go. CAP_SYS_ADMIN stays: systemd checks a uid-0 caller's
# capabilities, not its uid, before it starts or stops falcond on its behalf.
CapabilityBoundingSet=CAP_SYS_ADMIN
# Resource ceilings, far above what the helper uses and far below what a leak
# or a runaway loop in it could otherwise take: about 5 MiB resident (ps, and
# systemd's MemoryPeak of 4.6 MiB, on 2.3.1), and the main thread plus four
# runtime workers. A full cgroup makes an allocation or a thread fail inside
# the helper instead of pressing on the rest of the machine.
MemoryMax=64M
TasksMax=64
# No PrivateNetwork: in its own network namespace the unit's sysfs showed no
# cpufreq attributes (systemd 261, checked: SetCpuGovernor found none), and
# RestrictAddressFamilies=AF_UNIX already leaves it no network socket.

# Writes are confined to the locations the helper touches: the rest of the
# filesystem is read-only. ProtectSystem=strict leaves /sys writable, and on
# systemd 261 neither ProtectKernelTunables nor ReadOnlyPaths=/sys makes the
# fresh sysfs mount read-only (checked with test -w inside the unit), so
# every top-level /sys directory other than /sys/devices is listed read-only
# instead. The cpufreq, DRM card and V-Cache attributes the helper writes all
# live in /sys/devices; the /sys/class and /sys/bus paths it names are
# symlinks into it, and a write lands on the mount of the file it resolves to.
ProtectSystem=strict
ProtectKernelTunables=yes
ReadOnlyPaths=-/sys/block -/sys/bus -/sys/class -/sys/dev -/sys/firmware -/sys/fs -/sys/hypervisor -/sys/kernel -/sys/module -/sys/power
#
# A path that does not exist makes systemd refuse to start the service at all
# (226/NAMESPACE), so paths that depend on hardware or on falcond being
# installed carry the "-" prefix: ignored when absent.
#
# Only the user profiles: the system ones beside them may carry start
# scripts falcond runs as root, so the helper cannot write there. The package
# owns this directory, so it exists when the helper starts even if falcond is
# installed later; an absent one would stay read-only until a restart.
ReadWritePaths=-/usr/share/falcond/profiles/user
#
# falcond's global configuration. Its package ships no /etc/falcond, and an
# absent path is ignored above, which left / read-only and every save of the
# general configuration failing with EROFS; systemd creates it here and makes
# it writable.
ConfigurationDirectory=falcond
ConfigurationDirectoryMode=0755

# The record of how falcond was configured before Big Game Mode first took
# charge of it, so it can be handed back exactly. Created by systemd and
# writable despite ProtectSystem=strict; world-readable so the UI can say who
# owns falcond.
StateDirectory=bigame-mode
StateDirectoryMode=0755

[Install]
WantedBy=multi-user.target
