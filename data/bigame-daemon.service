[Unit]
Description=BiGame-mode privileged helper
Documentation=https://github.com/ruscher/bigamemode
After=dbus.service polkit.service
Requires=dbus.service
# Polkit is how every method authorizes its caller. Without it the helper
# denies everything, so starting before it is pointless.
Wants=polkit.service

[Service]
Type=dbus
BusName=com.biglinux.BiGameMode
ExecStart=/usr/bin/bigame-daemon
Restart=on-failure
RestartSec=3

# The helper needs root to write sysfs and /etc/falcond, but nothing beyond
# that. Everything below removes access it never uses, so a bug in argument
# handling has as little reach as possible.
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
# It reads no other process's /proc, no /dev and no /tmp (the status file
# falcond publishes there is read by the UI, not by the helper).
ProtectProc=invisible
ProcSubset=pid
PrivateDevices=yes
PrivateTmp=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @obsolete
UMask=0022

# Writes are confined to the locations the helper touches: the rest of the
# filesystem is read-only. ProtectKernelTunables is deliberately absent: the
# DRM card and V-Cache attributes are reached through symlinks into
# /sys/devices, which it would make read-only.
ProtectSystem=strict
#
# A path that does not exist makes systemd refuse to start the service at all
# (226/NAMESPACE), so everything that depends on hardware or on falcond being
# installed carries the "-" prefix: ignored when absent.
ReadWritePaths=-/etc/falcond -/usr/share/falcond/profiles /sys/devices/system/cpu -/sys/class/drm -/sys/bus/platform/drivers/amd_x3d_vcache

# The record of how falcond was configured before BiGame-mode first took
# charge of it, so it can be handed back exactly. Created by systemd and
# writable despite ProtectSystem=strict; world-readable so the UI can say who
# owns falcond.
StateDirectory=bigame-mode
StateDirectoryMode=0755

[Install]
WantedBy=multi-user.target
