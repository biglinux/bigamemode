<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "https://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">

<!--
  Authorization policy for the Big Game Mode privileged helper.

  Every action listed here is enforced by bigame-daemon, which calls
  CheckAuthorization before touching the system. Adding an action to this file
  does nothing on its own; the daemon must reference it.

  The split below is deliberate:

  * Performance knobs (CPU, GPU) are allowed for an active local session
    without a prompt. They are bounded, reversible, validated against a fixed
    value set, and no worse than what power-profiles-daemon already grants the
    same user. Requiring a password to turn Booster Mode on would make the
    feature unusable, and users would simply run the tweaks by hand as root.

  * Configuration and profile actions require administrator authentication,
    because they write files that falcond — which runs as root — later acts on.
    A per-game profile is not merely a preference; it is input to a root
    process, so it is held to a root-level bar.

  Remote and inactive sessions must always authenticate.

  Descriptions and messages are written in English only. They are in
  locale/bigame-mode.pot (locale/extract-strings.py), and the package build
  merges every catalogue into the installed copy with msgfmt (gettext's
  polkit.its rules), as it does for the desktop entry and AppStream file.
-->
<policyconfig>
  <vendor>BigLinux</vendor>
  <vendor_url>https://www.biglinux.com.br</vendor_url>
  <icon_name>com.biglinux.BiGameMode</icon_name>

  <action id="com.biglinux.bigamemode.control-backend">
    <description>Turn Turbo on or off</description>
    <message>Authentication is required to turn Turbo on or off</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="com.biglinux.bigamemode.set-cpu">
    <description>Change CPU performance settings</description>
    <message>Authentication is required to change CPU performance settings</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="com.biglinux.bigamemode.set-gpu">
    <description>Change GPU performance settings</description>
    <message>Authentication is required to change GPU performance settings</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="com.biglinux.bigamemode.set-vcache">
    <description>Change AMD 3D V-Cache mode</description>
    <message>Authentication is required to change the 3D V-Cache mode</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!--
    Writes /etc/falcond/config.conf, which the root falcond daemon reads and
    acts on system-wide. Administrator only.
  -->
  <action id="com.biglinux.bigamemode.write-config">
    <description>Write the falcond system configuration</description>
    <message>Authentication is required to modify the system gaming configuration</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <!--
    Per-game profiles are consumed by root falcond. The helper additionally
    refuses start_script/stop_script keys outright, since falcond spawns them
    through /bin/sh as root.
  -->
  <action id="com.biglinux.bigamemode.manage-profiles">
    <description>Create or delete game profiles</description>
    <message>Authentication is required to change game profiles</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
