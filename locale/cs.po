msgid "Appearance"
msgstr "Vzhled"

#: bigame-engine/bigame-ui/src/views/ai_graphics.rs:1081
msgid "Applied"
msgstr "Použito"

#: bigame-engine/bigame-ui/src/views/ai_graphics.rs:1080
msgid "Applied and active"
msgstr "Použito a aktivní"

#: bigame-engine/bigame-ui/src/views/report.rs:33 bigame-engine/bigame-ui/src/widgets/tutorial.rs:474
msgid "Applied and verified"
msgstr "Použito a ověřeno"

#: bigame-engine/bigame-ui/src/views/tuning.rs:274
msgid "Applied by falcond while Turbo is on, and undone when it is turned off. Saved through the privileged helper."
msgstr "Použije ho falcond, když je Turbo zapnuté, a vrátí zpět, když se vypne. Ukládá se přes privilegovaného pomocníka."

#: bigame-engine/bigame-ui/src/widgets/game_fields.rs:1473
msgid "Applied by falcond while this game runs, whichever launcher starts it. Saved through the privileged helper when you save."
msgstr "Použije ho falcond, dokud tato hra běží, ať ji spustí kterýkoli spouštěč. Při uložení se ukládá přes privilegovaného pomocníka."

#: bigame-engine/bigame-ui/src/views/report.rs:46
