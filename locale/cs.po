msgstr "Automaticky se řídí Laděním, kde je Gamescope zapnutý"

#: bigame-engine/bigame-ui/src/widgets/optimization.rs:768
msgid "Automatic: only when this game's own settings below need it"
msgstr "Automaticky: jen když to vyžaduje vlastní nastavení této hry níže"

#: bigame-engine/bigame-ui/src/views/details/gpus.rs:230
msgid "Available"
