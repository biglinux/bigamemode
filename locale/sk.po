msgid "Applied by falcond while Turbo is on, and undone when it is turned off. Saved through the privileged helper."
msgstr "Použije ho falcond, keď je Turbo zapnuté, a vráti späť, keď sa vypne. Ukladá sa cez privilegovaného pomocníka."

#: bigame-engine/bigame-ui/src/widgets/game_fields.rs:1473
msgid "Applied by falcond while this game runs, whichever launcher starts it. Saved through the privileged helper when you save."
msgstr "Použije ho falcond, kým táto hra beží, nech ju spustí ktorýkoľvek spúšťač. Pri uložení sa ukladá cez privilegovaného pomocníka."

#: bigame-engine/bigame-ui/src/views/report.rs:46
msgid "Applied while each game runs by the component that owns it, and restored when the game exits."
msgstr "Používa ho počas behu každej hry komponent, ktorý ho vlastní, a obnoví sa po ukončení hry."

#: bigame-engine/bigame-ui/src/views/ai_graphics.rs:885
msgid "Applied, but the game shows a problem — Diagnose says why"
msgstr "Použité, ale hra hlási problém — Diagnostika povie prečo"

#: bigame-engine/bigame-ui/src/views/ai_graphics.rs:1079
msgid "Applied, not working"
msgstr "Použité, nefunguje"

#: bigame-engine/bigame-ui/src/views/ai_graphics.rs:876
