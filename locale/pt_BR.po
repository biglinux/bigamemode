msgstr "Gráficos com IA…"

#: bigame-engine/bigame-ui/src/views/dashboard.rs:1143
msgid "AMD 3D V-Cache not available"
msgstr "AMD 3D V-Cache não disponível"

#: bigame-engine/bigame-ui/src/window.rs:384
msgid "About BiGame-mode"
msgstr "Sobre o BiGame-mode"

#: bigame-engine/bigame-ui/src/views/profiles.rs:916
msgid "Activate Profile"
msgstr "Ativar Perfil"

#: bigame-engine/bigame-ui/src/views/ai_graphics.rs:65
#: bigame-engine/bigame-ui/src/views/dashboard.rs:1058
#: bigame-engine/bigame-ui/src/views/dashboard.rs:589
