#: bigame-engine/bigame-ui/src/views/dashboard.rs:1008
#: bigame-engine/bigame-ui/src/views/dashboard.rs:231
msgid "Active Profile"
msgstr "Perfil Ativo"

#: bigame-engine/bigame-ui/src/views/tuning.rs:263
msgid "Active sched-ext scheduler"
msgstr "Escalonador sched-ext ativo"

#: bigame-engine/bigame-ui/src/views/video.rs:177
msgid "Adds ENABLE_VKBASALT=1 to game environment (requires vkBasalt)"
msgstr "Adiciona ENABLE_VKBASALT=1 ao ambiente do jogo (requer vkBasalt)"

