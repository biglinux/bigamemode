#~ msgid "<b>Device Mode</b> — Optimise kernel tuning for Gaming or Desktop workloads."
#~ msgstr "<b>Modo do Dispositivo</b> — otimiza os ajustes do kernel para uso em Jogos ou Desktop."

#~ msgid "<b>FSR Sharpness</b> — Controls Gamescope FSR sharpening strength (0 = maximum · 20 = softest)."
#~ msgstr "<b>Nitidez FSR</b> — Controla a intensidade de nitidez FSR do Gamescope (0 = máxima · 20 = mais suave)."

#~ msgid "<b>FSR</b> — FidelityFX Super Resolution upscaling. Sharpness: 0 = blurry · 20 = sharpest."
#~ msgstr "<b>FSR</b> — upscaling FidelityFX Super Resolution. Nitidez: 0 = borrado · 20 = mais nítido."

#~ msgid "<b>Falcond Daemon</b> — Start or stop the daemon and toggle auto-start on login."
#~ msgstr "<b>Daemon Falcond</b> — inicia ou para o daemon e liga ou desliga a inicialização automática ao entrar."

#~ msgid "<b>Falcond Status</b> — Live read of <tt>/tmp/falcond_status</tt>: current scheduler, governor and active profile."
#~ msgstr "<b>Status do Falcond</b> — leitura em tempo real de <tt>/tmp/falcond_status</tt>: escalonador, governor e perfil ativo no momento."

#~ msgid "<b>Frame Generation (lsfg-vk)</b> — Shows whether the Vulkan implicit layer is installed. No Steam launch options are needed — it activates automatically for configured games."
#~ msgstr "<b>Geração de Quadros (lsfg-vk)</b> — mostra se a camada implícita Vulkan está instalada. Não é preciso mexer nas opções de inicialização da Steam — ela é ativada automaticamente nos jogos configurados."

#~ msgid ""
#~ "<b>Frame Generation</b> — lsfg-vk Vulkan layer: inserts interpolated frames to boost perceived FPS.\n"
#~ "  · <b>Multiplier</b> (2–20): frames generated per real frame. Min 2 required by lsfg-vk.\n"
#~ "  · <b>Flow Scale</b> (25–100%): motion estimation resolution. Lower = faster; higher = quality.\n"
#~ "  · <b>Performance Mode</b>: lighter model with minor quality trade-off.\n"
#~ "  · <b>Lossless.dll Path</b>: optional custom DLL location (global/Tuning tab only)."
#~ msgstr ""
#~ "<b>Geração de Quadros</b> — camada Vulkan do lsfg-vk: insere quadros interpolados para aumentar o FPS percebido.\n"
#~ "  · <b>Multiplicador</b> (2–20): quadros gerados para cada quadro real. O lsfg-vk exige no mínimo 2.\n"
#~ "  · <b>Escala de Fluxo</b> (25–100%): resolução da estimativa de movimento. Menor = mais rápido; maior = mais qualidade.\n"
#~ "  · <b>Modo de Desempenho</b>: modelo mais leve, com pequena perda de qualidade.\n"
#~ "  · <b>Caminho do Lossless.dll</b>: local opcional de uma DLL personalizada (apenas global/aba Ajustes)."

#~ msgid "<b>Framerate Limit</b> — Hard cap on FPS for consistent frame pacing."
#~ msgstr "<b>Limite de FPS</b> — Limite máximo de FPS para cadência de quadros consistente."

#~ msgid ""
#~ "<b>Gamescope Upscaling</b> — Launches games inside a Gamescope compositor with spatial upscaling.\n"
#~ "  · <b>FSR 1.0</b>: AMD FidelityFX Super Resolution (best quality, GPU-agnostic)\n"
#~ "  · <b>NIS</b>: Nvidia Image Scaling (sharpening + upscale)\n"
#~ "  · <b>Integer Scaling</b>: crisp pixel-perfect scaling for retro games"
#~ msgstr ""
#~ "<b>Upscaling Gamescope</b> — Lança jogos dentro do compositor Gamescope com upscaling espacial.\n"
#~ "  · <b>FSR 1.0</b>: AMD FidelityFX Super Resolution (melhor qualidade, compatível com qualquer GPU)\n"
#~ "  · <b>NIS</b>: Nvidia Image Scaling (nitidez + upscale)\n"
#~ "  · <b>Escalonamento Inteiro</b>: escala pixel-perfeita para jogos retrô"

#~ msgid "<b>Gaming Services Journal</b> — journald entries from falcond and related gaming services."
