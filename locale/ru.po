#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:93
msgid ""
"<b>AFMF</b> — AMD Fluid Motion Frames. Driver-level frame generation for AMD "
"GPUs. Experimental on open-source RADV driver."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:118
msgid "<b>About</b> — App version, author and source code information."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:106
msgid ""
"<b>Application Log</b> — BiGame-mode internal events: profile loads, D-Bus "
"calls and errors."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:52
msgid ""
"<b>Auto-Apply</b> — Falcond detects the game process at launch and applies "
"the matching profile automatically."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:107
msgid ""
"<b>Auto-Refresh</b> — Logs update every 5 seconds. Click ↺ to force an "
"immediate refresh."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:64
msgid ""
"<b>CPU Governor</b> — Performance keeps frequency at maximum; Powersave "
"scales down to save energy."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:79
msgid ""
"<b>Command</b> — Game or program to launch inside Gamescope (e.g. <tt>steam "
"-gamepadui</tt>)."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:95
msgid ""
"<b>Conflict Warning</b> — OptiScaler and lsfg-vk both intercept the same "
"rendering pipeline. Running both simultaneously causes artifacts; disable "
"one."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:115
msgid ""
"<b>Dark Mode</b> — Force dark colour scheme regardless of the system theme."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:42
msgid ""
"<b>Detected Games</b> — Games found via Steam, Lutris and Heroic. Create a "
"performance profile or launch directly with Gamescope."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:67
msgid ""
"<b>Device Mode</b> — Optimise kernel tuning for Gaming or Desktop workloads."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:89
msgid ""
"<b>FSR Sharpness</b> — Controls Gamescope FSR sharpening strength (0 = "
"maximum · 20 = softest)."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:77
msgid ""
"<b>FSR</b> — FidelityFX Super Resolution upscaling. Sharpness: 0 = blurry · "
"20 = sharpest."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:40
msgid ""
"<b>Falcond Daemon</b> — Shows the active SCX scheduler, VCache mode and "
"current game profile."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:62
msgid ""
"<b>Falcond Daemon</b> — Start or stop the daemon and toggle auto-start on "
"login."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:103
msgid ""
"<b>Falcond Status</b> — Live read of <tt>/tmp/falcond_status</tt>: current "
"scheduler, governor and active profile."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:38
msgid ""
"<b>Frame Generation (lsfg-vk)</b> — Shows whether the Vulkan implicit layer "
"is installed. No Steam launch options are needed — it activates "
"automatically for configured games."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:66
msgid ""
"<b>Frame Generation</b> — lsfg-vk Vulkan layer: inserts interpolated frames "
"to boost perceived FPS.\n"
"  · <b>Multiplier</b> (2–20): frames generated per real frame. Min 2 "
"required by lsfg-vk.\n"
"  · <b>Flow Scale</b> (25–100%): motion estimation resolution. Lower = "
"faster; higher = quality.\n"
"  · <b>Performance Mode</b>: lighter model with minor quality trade-off.\n"
"  · <b>Lossless.dll Path</b>: optional custom DLL location (global/Tuning "
"tab only)."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:76
msgid "<b>Framerate Limit</b> — Hard cap on FPS for consistent frame pacing."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:116
msgid ""
"<b>Game Notifications</b> — Show desktop notifications when a game launches "
"or exits."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:88
msgid ""
"<b>Gamescope Upscaling</b> — Launches games inside a Gamescope compositor "
"with spatial upscaling.\n"
"  · <b>FSR 1.0</b>: AMD FidelityFX Super Resolution (best quality, GPU-"
"agnostic)\n"
"  · <b>NIS</b>: Nvidia Image Scaling (sharpening + upscale)\n"
"  · <b>Integer Scaling</b>: crisp pixel-perfect scaling for retro games"
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:104
msgid ""
"<b>Gaming Services Journal</b> — journald entries from falcond and related "
"gaming services."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:54
msgid ""
"<b>Import</b> — Load a .conf or .toml profile from disk. Drag-and-drop onto "
"the list also works."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:105
msgid ""
"<b>Kernel &amp; GPU Messages</b> — dmesg output filtered for GPU and gaming-"
"related entries."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:80
msgid ""
"<b>Launch</b> — Applies current settings and starts the Gamescope compositor."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:78
msgid ""
"<b>MangoHud</b> — Enable the MangoHud performance overlay inside the "
"Gamescope window."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:53
msgid ""
"<b>New Profile (+)</b> — Create a blank profile and customise every "
"parameter manually."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:92
msgid ""
"<b>OptiScaler</b> — Replaces DLSS3 Frame Generation with FSR 3 / XeSS in "
"compatible games. Stages DLLs into the game prefix on launch."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:51
msgid ""
"<b>Per-game Profiles</b> — Override global Tuning settings for a specific "
"game executable."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:37
msgid ""
"<b>Performance Booster</b> — Enable or disable falcond for gaming "
"optimisations."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:117
msgid ""
"<b>Ping Target</b> — Hostname or IP used by the Dashboard latency sparkline "
"(default: 8.8.8.8)."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:39
msgid ""
"<b>Power Profile</b> — Current system power profile (Balanced / "
"Performance / Power Saver)."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:50
msgid ""
"<b>Profile Wizard</b> — Guided setup with presets optimised for competitive "
"FPS, strategy, simulation and more."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:75
msgid ""
"<b>Resolution</b> — Set the game render resolution independently from your "
"desktop resolution."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:63
msgid ""
"<b>SCX Scheduler</b> — sched-ext BPF CPU scheduler:\n"
"  · bpfland — Low latency, ideal for competitive games\n"
"  · lavd — Load-aware, good for mixed workloads\n"
"  · rusty — General-purpose, stable default\n"
"  · flash — Maximum throughput"
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:36
msgid "<b>Stat Bar</b> — CPU frequency, GPU temperature and RAM at a glance."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:41
msgid ""
"<b>System Telemetry</b> — Live sparkline graphs: CPU/GPU frequency, GPU "
"temperature, disk I/O, network latency and RAM usage."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:65
msgid ""
"<b>VCache Mode</b> — AMD Ryzen X3D only. Game Mode routes workloads to the "
"VCache chiplet for lower memory latency."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:90
msgid ""
"<b>Wine/Proton FSR</b> — Sets <tt>WINE_FULLSCREEN_FSR=1</tt> in the game "
"environment, enabling in-game TAA + FSR upscaling via Wine/Proton without "
"Gamescope."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:94
msgid ""
"<b>lsfg-vk</b> — Lossless Scaling Frame Generation via a Vulkan implicit "
"layer. Configured globally in the Tuning tab."
msgstr ""

#: bigame-engine/bigame-ui/src/widgets/tutorial.rs:91
msgid ""
"<b>vkBasalt Post-Processing</b> — Sets <tt>ENABLE_VKBASALT=1</tt> to "
"activate the vkBasalt Vulkan post-processing layer (CAS sharpening, FXAA, "
"SMAA)."
msgstr ""

