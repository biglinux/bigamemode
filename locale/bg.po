msgstr "BiGame-mode не е инсталирал нищо в %s"

#: bigame-engine/bigame-ui/src/views/settings.rs:121
msgid "BiGame-mode has managed falcond since %s"
msgstr "BiGame-mode управлява falcond от %s"

#: bigame-engine/bigame-ui/src/profile_offer.rs:208
