#: bigame-engine/bigame-ui/src/views/tuning.rs:520
msgid "Applied by falcond while Turbo is on, and undone when it is turned off. Saved through the privileged helper."
msgstr "Tillämpas av falcond medan Turbo är på och ångras när det stängs av. Sparas via den privilegierade hjälparen."

#: bigame-engine/bigame-ui/src/widgets/game_fields.rs:1500
msgid "Applied by falcond while this game runs, whichever launcher starts it. Saved through the privileged helper when you save."
msgstr "Tillämpas av falcond medan det här spelet körs, oavsett vilken startare som startar det. Sparas via den privilegierade hjälparen när du sparar."

#: bigame-engine/bigame-ui/src/views/report.rs:46
msgid "Applied while each game runs by the component that owns it, and restored when the game exits."
msgstr "Tillämpas medan varje spel körs av komponenten som äger det, och återställs när spelet avslutas."

#: bigame-engine/bigame-ui/src/views/ai_graphics.rs:898
msgid "Applied, but the game shows a problem — Diagnose says why"
msgstr "Tillämpad, men spelet visar ett problem — Diagnostisera berättar varför"

#: bigame-engine/bigame-ui/src/views/ai_graphics.rs:1098
